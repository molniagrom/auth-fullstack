@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title C4 Level 4 - Client Request Credentials Strategy

Container_Boundary(client_transport_flow, "Client Request Credentials Strategy") {
    Component(public_requests, "Public Requests", "HTTP client calls", "register, verify-email, resend-code")
    Component(protected_request, "Protected Request", "HTTP client call", "GET /auth/me with Authorization Bearer access token")
    Component(login_request, "Login Request", "HTTP client call", "POST /auth/login with withCredentials: true so browser can accept refresh cookie")
    Component(refresh_request, "Refresh Request", "HTTP client call", "POST /auth/refresh with withCredentials: true so browser sends refresh cookie")
    Component(logout_request, "Logout Request", "HTTP client call", "POST /auth/logout with withCredentials: true so browser sends refresh cookie to revoke session")
    Component(access_header_strategy, "Access Header Strategy", "Client auth rule", "Access token is sent only in Authorization header, not in cookies")
    Component(credentials_strategy, "Credentials Strategy", "Client transport rule", "withCredentials is enabled only for requests that need refresh cookie exchange")
}

Container(browser_cookie_jar, "Browser Cookie Jar", "Browser storage", "Stores httpOnly refresh token cookie")
Container(backend_api, "Backend API", "Node/Express", "Handles auth routes")

Rel(public_requests, credentials_strategy, "does not enable withCredentials")
Rel(public_requests, backend_api, "POST /auth/register, /auth/verify-email, /auth/resend-code", "JSON only")

Rel(protected_request, access_header_strategy, "adds Authorization header")
Rel(access_header_strategy, backend_api, "GET /auth/me", "Authorization: Bearer <accessToken>")
Rel(protected_request, credentials_strategy, "does not enable withCredentials")

Rel(login_request, credentials_strategy, "enables withCredentials")
Rel(login_request, backend_api, "POST /auth/login", "JSON + credentials")
Rel(backend_api, browser_cookie_jar, "Set-Cookie refreshToken", "browser accepts cookie only because credentials are enabled")

Rel(refresh_request, credentials_strategy, "enables withCredentials")
Rel(browser_cookie_jar, refresh_request, "browser attaches refreshToken cookie automatically")
Rel(refresh_request, backend_api, "POST /auth/refresh", "credentials + cookie")
Rel(backend_api, browser_cookie_jar, "Set-Cookie rotated refreshToken", "browser overwrites old cookie")

Rel(logout_request, credentials_strategy, "enables withCredentials")
Rel(browser_cookie_jar, logout_request, "browser attaches refreshToken cookie automatically")
Rel(logout_request, backend_api, "POST /auth/logout", "credentials + cookie")
Rel(backend_api, browser_cookie_jar, "Clear-Cookie refreshToken", "browser removes refresh cookie")

@enduml
